# Configuracao local. Nunca versione o arquivo .env real.
TZ=America/Manaus
LOG_LEVEL=INFO

# NASA NeoWS
NASA_API_KEY=replace_with_your_nasa_api_key
NASA_API_BASE=https://api.nasa.gov
NASA_API_RESOURCE=neo/rest/v1/feed

# Banco alvo do projeto. Dentro do Docker o host e sempre postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nasa_etl
POSTGRES_USER=nasa_app
POSTGRES_PASSWORD=replace_with_a_48_char_hex_secret
POSTGRES_HOST_BIND=127.0.0.1

# AWS S3 Bronze. Em EC2, prefira uma IAM role de instancia (sem chaves estaticas).
# Em desenvolvimento local, use o provider AWS configurado no host/Container.
# Se precisar usar credenciais locais temporarias, mantenha-as somente no .env,
# nunca em Terraform ou Git; no servidor, deixe estes campos vazios.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET_NAME=replace_with_bucket_name_created_for_this_project
S3_PREFIX=bronze

# Backup semanal: export JSON comprimido, armazenado no S3 e enviado por SMTP.
# Use senha de app/credencial SMTP dedicada; nunca reutilize senha pessoal.
BACKUP_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
BACKUP_EMAIL_MAX_ATTACHMENT_MB=15

# Retencao dos artefatos JSON/CSV produzidos pelo ETL.
DATA_DIR=data
DATA_RETENTION_DAYS=90

# Airflow com LocalExecutor e banco de metadados separado do banco nasa_etl.
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_FERNET_KEY=replace_with_a_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_long_random_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_long_random_secret
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_a_different_48_char_hex_secret

# Interfaces opcionais de observabilidade.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_secret
AIRFLOW_HOST_BIND=127.0.0.1
GRAFANA_HOST_BIND=127.0.0.1
