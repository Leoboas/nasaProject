# Configuração local. Nunca versione o arquivo .env real.
TZ=America/Manaus
LOG_LEVEL=INFO

# NASA NeoWS
NASA_API_KEY=replace_with_your_nasa_api_key
NASA_API_BASE=https://api.nasa.gov
NASA_API_RESOURCE=neo/rest/v1/feed

# PostgreSQL usado pelo ETL e pelo dashboard local.
# O Streamlit Cloud recebe os mesmos valores como DB_* nos Secrets da aplicação.
POSTGRES_HOST=postgres
# Este host Ã© imutÃ¡vel para o projeto; nÃ£o use RDS ou recursos do Vortex.
POSTGRES_PORT=5432
POSTGRES_DB=nasa_etl
POSTGRES_USER=nasa_app
POSTGRES_PASSWORD=replace_with_a_48_char_hex_secret
POSTGRES_HOST_BIND=127.0.0.1

# AWS S3 Bronze (prefira IAM/SSO ou instance profile em producao).
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET_NAME=nasa-project-bronze-data-669591254483-us-east-2-an
S3_PREFIX=bronze

# Retenção dos artefatos JSON/CSV produzidos pelo ETL.
DATA_DIR=data
DATA_RETENTION_DAYS=90

# Variáveis necessárias somente para a demonstração Airflow/Grafana em Docker.
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_FERNET_KEY=replace_with_a_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_long_random_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_long_random_secret
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_a_different_48_char_hex_secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_secret
AIRFLOW_HOST_BIND=127.0.0.1
GRAFANA_HOST_BIND=127.0.0.1
