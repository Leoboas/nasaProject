# Nunca versione o .env real. Gere valores aleatórios sem caracteres especiais
# para as senhas usadas na URL de conexão PostgreSQL.
TZ=America/Manaus
LOG_LEVEL=INFO

# NASA API
NASA_API_KEY=replace_with_your_nasa_api_key
NASA_API_BASE=https://api.nasa.gov
NASA_API_RESOURCE=neo/rest/v1/feed

# PostgreSQL
# No Compose de demonstração use postgres; na EC2 runtime este valor é
# sobrescrito internamente para o container postgres.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nasa_etl
POSTGRES_USER=nasa_app
POSTGRES_PASSWORD=replace_with_a_48_char_hex_secret

# Diretório de artefatos do runner local.
DATA_DIR=data
DATA_RETENTION_DAYS=90

# Airflow/Grafana: usados apenas pelo docker-compose.yml de demonstração.
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_FERNET_KEY=replace_with_a_fernet_key
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_long_random_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_a_long_random_secret
AIRFLOW_ADMIN_EMAIL=admin@example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_secret

# UIs ficam acessíveis apenas por SSH tunnel por padrão.
AIRFLOW_HOST_BIND=127.0.0.1
GRAFANA_HOST_BIND=127.0.0.1
