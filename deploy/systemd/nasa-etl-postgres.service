[Unit]
Description=PostgreSQL local do NASA ETL
Wants=docker.service network-online.target
After=docker.service network-online.target
ConditionPathExists=/etc/nasa-etl/nasa-etl.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nasa-etl
ExecStart=/usr/bin/docker compose --env-file /etc/nasa-etl/nasa-etl.env -f /opt/nasa-etl/deploy/compose/docker-compose.ec2.yml up -d postgres
ExecStop=/usr/bin/docker compose --env-file /etc/nasa-etl/nasa-etl.env -f /opt/nasa-etl/deploy/compose/docker-compose.ec2.yml stop postgres
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
