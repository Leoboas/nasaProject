FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN groupadd --gid 10001 nasaetl \
    && useradd --uid 10001 --gid nasaetl --create-home --shell /usr/sbin/nologin nasaetl \
    && install -d --owner=nasaetl --group=nasaetl /var/lib/nasa-etl/data

COPY requirements.runtime.txt /tmp/requirements.runtime.txt
RUN pip install --no-cache-dir -r /tmp/requirements.runtime.txt

COPY --chown=nasaetl:nasaetl etl ./etl
COPY --chown=nasaetl:nasaetl scripts/run_etl.py ./scripts/run_etl.py

USER nasaetl
ENTRYPOINT ["python", "scripts/run_etl.py"]
