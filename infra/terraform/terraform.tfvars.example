aws_region   = "us-east-1"
project_name = "nasa-etl-demo"
bucket_name  = "nasa-etl-demo"

# Banco e alertas (copie para terraform.tfvars, que é ignorado pelo Git)
db_password = "replace_with_a_long_random_secret"
alert_email = "seu_email@exemplo.com"

# Opcional: overrides
# db_instance_class = "db.t3.micro"
# db_allocated_storage = 20
# s3_storage_threshold_gb = 4.5
# s3_put_requests_threshold = 1800
# rds_free_storage_threshold_gb = 2
# budget_limit = 1.0

# RDS permanece privado. Prefira o SG da EC2 criada em infra/ec2:
# rds_client_security_group_ids = ["sg-0123456789abcdef0"]
# rds_admin_cidrs = []
